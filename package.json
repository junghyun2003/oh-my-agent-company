{
  "name": "oh-my-agent-company",
  "version": "0.1.0",
  "private": true,
  "description": "Local orchestration dashboard and policy-driven multi-agent workflow",
  "scripts": {
    "install:local": "bash ./scripts/npm_support.sh",
    "bootstrap:local": "bash ./scripts/bootstrap_local.sh",
    "server:start": "bash ./scripts/infra_server_ctl.sh start",
    "server:status": "bash ./scripts/infra_server_ctl.sh status",
    "server:ensure": "bash ./scripts/infra_server_ctl.sh ensure",
    "server:watch": "bash ./scripts/infra_server_ctl.sh watch-start",
    "server:health": "bash ./scripts/infra_server_ctl.sh health",
    "ops:queue:summary": "python3 ./scripts/ops_queue_manager.py summary",
    "ops:queue:dry-run": "python3 ./scripts/ops_queue_manager.py apply --dry-run",
    "ops:queue:apply": "python3 ./scripts/ops_queue_manager.py apply",
    "todo:list": "python3 ./scripts/todo_workflow.py list",
    "todo:start": "python3 ./scripts/todo_workflow.py start",
    "todo:complete": "python3 ./scripts/todo_workflow.py complete"
  }
}
